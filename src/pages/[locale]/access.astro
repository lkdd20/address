---
import { localeDefinitions, localeStaticPaths } from '../../domain/locales';
import type { Locale } from '../../domain/types';

export const getStaticPaths = localeStaticPaths;
const locale = Astro.params.locale as Locale;
const copy: Record<Locale, { prompt: string; password: string; enter: string; invalid: string }> = {
  en: { prompt: 'Enter the site access password', password: 'Access password', enter: 'Continue', invalid: 'Incorrect password' },
  'zh-CN': { prompt: '请输入站点访问密码', password: '访问密码', enter: '进入', invalid: '密码不正确' },
  'zh-TW': { prompt: '請輸入網站存取密碼', password: '存取密碼', enter: '進入', invalid: '密碼不正確' },
  ja: { prompt: 'サイトのアクセスパスワードを入力してください', password: 'アクセスパスワード', enter: '続行', invalid: 'パスワードが正しくありません' },
  ko: { prompt: '사이트 접근 비밀번호를 입력하세요', password: '접근 비밀번호', enter: '계속', invalid: '비밀번호가 올바르지 않습니다' },
  de: { prompt: 'Geben Sie das Zugangspasswort ein', password: 'Zugangspasswort', enter: 'Weiter', invalid: 'Falsches Passwort' },
  fr: { prompt: "Saisissez le mot de passe d'accès au site", password: "Mot de passe d'accès", enter: 'Continuer', invalid: 'Mot de passe incorrect' },
  es: { prompt: 'Introduce la contraseña de acceso al sitio', password: 'Contraseña de acceso', enter: 'Continuar', invalid: 'Contraseña incorrecta' },
  pt: { prompt: 'Introduza a palavra-passe de acesso ao site', password: 'Palavra-passe de acesso', enter: 'Continuar', invalid: 'Palavra-passe incorreta' }
};
const t = copy[locale];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Address</title>
    <style>
      :root{font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans SC",sans-serif;color:#1f2937;background:#f4f6f8}*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center}.card{width:min(420px,calc(100% - 32px));padding:32px;border:1px solid #d7dde5;border-radius:8px;background:#fff;box-shadow:0 16px 40px rgba(16,24,40,.08)}.toolbar{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:8px}h1{margin:0;font-size:24px}.language-select{height:36px;max-width:150px;padding:0 30px 0 10px;border:1px solid #aeb7c4;border-radius:7px;background:#fff}p{margin:0 0 22px;color:#667085;font-size:13px}form{display:grid;gap:12px}input,button{height:44px;border-radius:7px;font:inherit}input{padding:0 12px;border:1px solid #aeb7c4}button{border:0;color:#fff;background:#155eef;font-weight:750;cursor:pointer}.error{min-height:18px;color:#b42318;font-size:12px}
    </style>
  </head>
  <body>
    <main class="card">
      <div class="toolbar"><h1>Address</h1><select id="locale" class="language-select" aria-label="Language">{localeDefinitions.map((definition) => <option value={definition.code} selected={definition.code === locale}>{definition.label}</option>)}</select></div>
      <p>{t.prompt}</p>
      <form id="access-form" data-locale={locale} data-invalid={t.invalid}>
        <input id="password" type="password" autocomplete="current-password" required aria-label={t.password} />
        <button type="submit">{t.enter}</button>
        <div id="error" class="error" role="alert"></div>
      </form>
    </main>
    <script>
      import { safeReturnPath } from '../../domain/locales';
      const localeSelect = document.querySelector<HTMLSelectElement>('#locale')!;
      localeSelect.addEventListener('change', () => location.assign(`/${localeSelect.value}/access/${location.search}${location.hash}`));
      const form = document.querySelector<HTMLFormElement>('#access-form')!;
      const error = document.querySelector<HTMLElement>('#error')!;
      const button = form.querySelector<HTMLButtonElement>('button')!;
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (button.disabled) return;
        error.textContent = ''; button.disabled = true;
        try {
          const response = await fetch('/web-api/v1/auth/login', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password: document.querySelector<HTMLInputElement>('#password')!.value }),
            credentials: 'same-origin', signal: AbortSignal.timeout(15_000)
          });
          if (!response.ok) throw new Error(response.status === 401 ? form.dataset.invalid : `HTTP ${response.status}`);
          location.replace(safeReturnPath(new URLSearchParams(location.search).get('next'), location.origin, `/${form.dataset.locale}/`));
        } catch (value) {
          error.textContent = value instanceof Error ? value.message : String(value);
        } finally { button.disabled = false; }
      });
    </script>
  </body>
</html>
